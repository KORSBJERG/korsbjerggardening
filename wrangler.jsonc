{
  "name": "korsbjerggardening",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-custom.mjs"
  },
  "vars": {
    "PORTAL_ORIGIN": "https://antons-korsbjerg-gardening.peaknet.chatgpt.site"
  },
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "korsbjerg-gardening-portal",
      "database_id": "32fe6415-62d9-439f-be20-1a4cff23646d",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "korsbjerg-gardening-portal",
      "jurisdiction": "eu"
    }
  ]
}
