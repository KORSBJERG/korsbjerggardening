{
  "name": "korsbjerggardening",
  "main": "worker/cloudflare.js",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "build": {"command": "node scripts/build-custom.mjs"},
  "vars": {
    "PORTAL_PUBLIC_ORIGIN": "https://korsbjerggardening.peter-be8.workers.dev",
    "MS_ADMIN_EMAIL": "anton@korsbjerg.dk"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "korsbjerg-portal",
    "database_id": "REPLACE_WITH_DATABASE_ID",
    "migrations_dir": "drizzle"
  }],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"REPLACE_WITH_BUCKET_NAME"}]
}
