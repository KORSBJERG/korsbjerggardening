# Configure production variables in Sites runtime environment settings.
# The local preview does not automatically read this file.
# Never commit real API keys or production secrets.

# Optional, needed for direct email delivery with PDF attachments:
RESEND_API_KEY=
MAIL_FROM=

# Optional canonical origin when a custom domain is connected:
PUBLIC_SITE_URL=

# Required bootstrap: verified Sites login email of the existing owner.
# Set only in Sites runtime settings, never in client code.
PORTAL_OWNER_EMAIL=

# Standalone portal only; keep Sites on its own managed identity.
# Enable only after DB/R2 migration, Microsoft and email are configured.
PORTAL_AUTH_MODE=
PORTAL_PUBLIC_ORIGIN=
MS_TENANT_ID=
MS_CLIENT_ID=
MS_ADMIN_OBJECT_ID=
MS_ADMIN_EMAIL=anton@korsbjerg.dk
MS_CLIENT_SECRET=
